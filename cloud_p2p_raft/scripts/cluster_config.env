# ========== CLUSTER CONFIGURATION ==========
# Set the role of this machine:
#   node1, node2, node3, proxy, client
ROLE="node1"

# IPs of the 3 node machines:
NODE1_IP="192.168.1.10"
NODE2_IP="192.168.1.11"
NODE3_IP="192.168.1.12"

# Ports for Raft communication:
NODE1_PORT="7001"
NODE2_PORT="7002"
NODE3_PORT="7003"

# Ports for client API:
CLIENT1_PORT="9001"
CLIENT2_PORT="9002"
CLIENT3_PORT="9003"

# Proxy machine IP and port:
PROXY_IP="192.168.1.20"
PROXY_PORT="9100"
